# ===========================================================================
# Multilingual file for the TOS 7 Docker application "dokuwikidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "DokuWiki is a file-based wiki: write pages in its own light markup, attach files, add namespaces, templates, access control and plugins, and keep a full revision history - all stored as plain files in the application data folder, with no database server required."
release_note = "1. First release: DokuWiki 2026-07-14c from Docker Hub as a non-root container. File-based wiki with revisions, attachments and ACLs; data in the application data folder."
important    = "Requires DockerEngine (installed automatically if missing). Open the site and run the installer (/install.php) to create the admin account and set the ACL policy; pages and attachments live in DockerAppData/dokuwikidocker/data. Plain HTTP; use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "DokuWiki 是基于文件的 wiki：用自带轻量标记写页面、上传附件、划分命名空间，支持模板、访问控制与插件，并保留完整修订历史——全部以普通文件保存在应用数据目录，不需要数据库服务。"
release_note = "1. 首个版本：基于 Docker Hub 的 DokuWiki 2026-07-14c，以非 root 容器运行。基于文件的 wiki，支持修订、附件与 ACL；数据保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。打开站点后先运行安装程序（/install.php）创建管理员账号并设置 ACL 策略；页面与附件保存在 DockerAppData/dokuwikidocker/data。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "DokuWiki 是基於檔案的 wiki：用自帶輕量標記寫頁面、上傳附件、劃分命名空間，支援模板、存取控制與插件，並保留完整修訂歷史——全部以普通檔案保存在應用資料目錄，不需要資料庫服務。"
release_note = "1. 首個版本：基於 Docker Hub 的 DokuWiki 2026-07-14c，以非 root 容器運行。基於檔案的 wiki，支援修訂、附件與 ACL；資料保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。開啟站點後先執行安裝程式（/install.php）建立管理員帳號並設定 ACL 策略；頁面與附件保存在 DockerAppData/dokuwikidocker/data。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。"

