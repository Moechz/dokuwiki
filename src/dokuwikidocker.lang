# ===========================================================================
# Multilingual file for the TOS 7 Docker application "dokuwikidocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "Self-hosted DokuWiki: a wiki kept as plain files on your NAS, with no database server. Write pages in DokuWiki markup, group them into namespaces, upload images and files as attachments, and keep every revision. Includes sidebar, full-text search, RSS/ATOM feeds, templates, user accounts with groups, per-page and per-namespace ACL, and an extension manager for plugins. Everything stays in the application data folder."
release_note = "Remediated per review comments (C3 C4 C5 C7 C9 C10 T1): complete privacy policy with data access, correction and deletion channels; description corrected to the features actually delivered; README and repository layout completed; the container now uses the upstream entrypoint with Apache on port 8080, so the wiki data directory is no longer served as static files and accounts, ACL and settings persist in the application data folder."
important    = "Requires DockerEngine. Open the app once and run the installer (/install.php) to create the administrator account and set the ACL policy. Pages, attachments, revisions, accounts and ACL rules are stored in DockerAppData/dokuwikidocker/data. The UI is plain HTTP - put a TLS reverse proxy in front of it before exposing it to the internet. The update check can be turned off in the admin Configuration."

[zh-cn]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "自建 DokuWiki：全部以普通文件存放在 NAS 上的 wiki，不需要数据库服务。用 DokuWiki 语法写页面、按命名空间归类、上传图片与附件，并保留每一次修订。内置侧边栏、全文检索、RSS/ATOM 订阅、模板、用户账号与分组、按页面/命名空间的 ACL，以及可在线安装插件的扩展管理器。数据都保存在应用数据目录。"
release_note = "针对上轮审核意见的整改（C3/C4/C5/C7/C9/C10/T1）：补齐隐私政策与用户数据访问/更正/删除渠道，描述改为与真实功能一致，补全 README 与仓库目录结构，并改用上游镜像自带入口以 Apache（8080）运行——数据目录不再被当作静态文件对外提供，账号、ACL 与设置改为随应用数据持久保存。"
important    = "需要 DockerEngine。首次打开后运行安装程序（/install.php）创建管理员账号并设置 ACL 策略。页面、附件、修订、账号与 ACL 规则都保存在 DockerAppData/dokuwikidocker/data。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理；更新检查可在管理后台的「配置」中关闭。"

[zh-hk]
name         = "DokuWiki"
auth         = "dokuwiki"
version      = "@@VERSION@@"
descript     = "自建 DokuWiki：全部以普通檔案存放在 NAS 上的 wiki，不需要資料庫服務。用 DokuWiki 語法寫頁面、按命名空間歸類、上傳圖片與附件，並保留每一次修訂。內建側邊欄、全文檢索、RSS/ATOM 訂閱、模板、使用者帳號與群組、按頁面/命名空間的 ACL，以及可線上安裝外掛的擴充管理器。資料都保存在應用資料目錄。"
release_note = "針對上輪審核意見的整改（C3/C4/C5/C7/C9/C10/T1）：補齊隱私政策與使用者資料存取/更正/刪除渠道，描述改為與真實功能一致，補全 README 與倉庫目錄結構，並改用上游映像自帶入口以 Apache（8080）執行——資料目錄不再被當作靜態檔案對外提供，帳號、ACL 與設定改為隨應用資料持久保存。"
important    = "需要 DockerEngine。首次開啟後執行安裝程式（/install.php）建立管理員帳號並設定 ACL 策略。頁面、附件、修訂、帳號與 ACL 規則都保存在 DockerAppData/dokuwikidocker/data。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理；更新檢查可在管理後台的「設定」中關閉。"

